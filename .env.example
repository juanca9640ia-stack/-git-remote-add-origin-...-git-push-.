SECRET_KEY=genera-una-clave-nueva-y-unica-para-tu-instalacion
DEBUG=False
ALLOWED_HOSTS=tu-dominio.com,www.tu-dominio.com

# Producción (Render): se conecta a PostgreSQL en vez de SQLite.
# En Render, si usas render.yaml, esta variable se completa sola al enlazar la base de datos.
# Formato: postgres://usuario:password@host:puerto/nombre_bd
DATABASE_URL=

# Solo necesario si usas un dominio propio además del *.onrender.com (que se detecta solo).
CSRF_TRUSTED_ORIGINS=
